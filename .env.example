# Konfigurasi Rice Genomics & Genetic Engineering API

# Base URL NCBI Datasets v2 API
NCBI_BASE_URL=https://api.ncbi.nlm.nih.gov/datasets/v2

# NCBI API Key (Opsional)
# Dapatkan gratis di: https://www.ncbi.nlm.nih.gov/account/settings/
# Meningkatkan batas laju pemanggilan dari 5 rps menjadi 10 rps
# NCBI_API_KEY=your_ncbi_api_key_here

# Timeout Permintaan HTTP (detik)
HTTP_TIMEOUT_SECONDS=30.0

# Takson Padi Default (39947 = Oryza sativa Japonica Group / Nipponbare)
DEFAULT_RICE_TAXON=39947

